# Pinned tool versions. Sourced by every script and read by the CI workflow.
# Godot editor and export templates: same version (ENG-GODOT-001, ENG-GODOT-005).
GODOT_VERSION=4.7.2
GODOT_RELEASE_TAG=4.7.2-stable
GODOT_BASE_URL=https://github.com/godotengine/godot-builds/releases/download/4.7.2-stable
# Expected SHA512 of the two downloads, copied from the official SHA512-SUMS.txt of release 4.7.2-stable
# (ENG-CI-009). They are pinned here on purpose: the checksum file next to a download is not trusted.
# When bumping GODOT_VERSION, update both values from the new official SHA512-SUMS.txt and review the diff.
GODOT_EDITOR_SHA512=9aa00f7a605200940bce3027a567b782f49bd8e940dd06ae9e987bd65aee1b1467edd56ed84fcdcbdd44354bf613bdbb4e5d2913e925850368e150c59ed54c65
GODOT_TEMPLATES_SHA512=ca4d71c4d7b81dfc15d1a98baa07534aa95b03fdda78a0075b06672e1648d2e5f40980c9adc28d23e1b92e732ee7bf3461997aa804af74ec2fcd7a93ccb84079
# GdUnit4: newest tagged release (v6.2.3); its README does not list Godot 4.7.2 (see ENG-CI-002 and
# check C1 in docs/decisions/0001-engine.md). Pinned by commit so a moved tag cannot change the code.
GDUNIT4_REPO=https://github.com/godot-gdunit-labs/gdUnit4
GDUNIT4_TAG=v6.2.3
GDUNIT4_COMMIT=f2e4f8679ebd28e27ef523a4fb7b09e8337bfce9
# Android toolchain (ENG-GODOT-004).
ANDROID_PLATFORM=android-35
ANDROID_BUILD_TOOLS=35.0.1
# sdkmanager cannot pin platform-tools: it installs the newest (37.0.3 on 2026-11-25, ENG-CI-012).
# ENG-GODOT-004 asks for >= 35.0.0, so that is the enforced minimum; the installed version is printed.
ANDROID_PLATFORM_TOOLS_MIN=35.0.0
# Bootstrap for sdkmanager: versioned zip and the SHA-256 listed on https://developer.android.com/studio
# (ENG-CI-010). "cmdline-tools;latest" is then installed through sdkmanager (its own package checksums).
ANDROID_CMDLINE_TOOLS_ZIP=commandlinetools-linux-15859902_latest.zip
ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ANDROID_CMAKE=3.10.2.4988404
ANDROID_NDK=28.1.13356709
JDK_MAJOR=17
