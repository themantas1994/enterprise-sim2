# Pinned tool versions. Sourced by every script and read by the CI workflow.
# Godot editor and export templates: same version (ENG-GODOT-001, ENG-GODOT-005).
GODOT_VERSION=4.7.2
GODOT_RELEASE_TAG=4.7.2-stable
GODOT_BASE_URL=https://github.com/godotengine/godot-builds/releases/download/4.7.2-stable
# GdUnit4: newest tagged release (v6.2.3); its README does not list Godot 4.7.2 (see ENG-CI-002 and
# check C1 in docs/decisions/0001-engine.md). Pinned by commit so a moved tag cannot change the code.
GDUNIT4_REPO=https://github.com/godot-gdunit-labs/gdUnit4
GDUNIT4_TAG=v6.2.3
GDUNIT4_COMMIT=f2e4f8679ebd28e27ef523a4fb7b09e8337bfce9
# Android toolchain (ENG-GODOT-004).
ANDROID_PLATFORM=android-35
ANDROID_BUILD_TOOLS=35.0.1
ANDROID_PLATFORM_TOOLS=35.0.0
ANDROID_CMAKE=3.10.2.4988404
ANDROID_NDK=28.1.13356709
JDK_MAJOR=17
