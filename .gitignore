# Godot
.godot/
.import/
*.translation
# Build output and reports
build/
*.apk
*.aab
*.exe
*.x86_64
*.pck
# Signing material and secrets: never commit
*.keystore
*.jks
*.p12
*.pem
*.pfx
*.key
*.p8
keystore.properties
local.properties
export_credentials.cfg
.env
.env.*
# Third-party test framework, fetched at the pinned commit by scripts/install_gdunit4.sh
addons/
# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp
# Gradle build template (android/build/) will be committed later, so android/ is NOT ignored wholesale.
# Only generated Gradle output is ignored.
android/build/build/
android/build/.gradle/
android/build/.cxx/
# Tool install dir used by CI (scripts/env.sh GODOT_HOME)
.godot-tools/
